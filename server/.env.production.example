NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://senderwho.com
MOCK_DATA_ENABLED=false
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=256kb
SWAGGER_ENABLED=false

# Inject all credentials at runtime through workload identity/secret management.
DATABASE_URL=mysql://runtime-user:secret@private-mysql:3306/senderwho?sslaccept=strict

JWT_SECRET=from-secret-manager-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=365
TOKEN_ENCRYPTION_KEYS=key-2026-07:base64-encoded-32-byte-key
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=key-2026-07

GOOGLE_CLIENT_ID=production-client-id
GOOGLE_CLIENT_SECRET=from-secret-manager
GOOGLE_OAUTH_CALLBACK_URL=https://senderwho.com/api/v1/auth/oauth/google/callback
# Keep disabled until Yahoo approves mail-r and mail-w for this application.
YAHOO_OAUTH_ENABLED=false
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_OAUTH_CALLBACK_URL=https://senderwho.com/api/v1/auth/oauth/yahoo/callback
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
GMAIL_INITIAL_SYNC_MAX_MESSAGES=500
GMAIL_SYNC_BATCH_SIZE=20
GMAIL_SYNC_CONCURRENCY=5

MESSAGE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
JOB_RETENTION_DAYS=90
