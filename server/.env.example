NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MOCK_DATA_ENABLED=true
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=256kb
SWAGGER_ENABLED=true

# Public website and policy contact
PUBLIC_LEGAL_NAME=SenderWho
PUBLIC_SUPPORT_EMAIL=
PUBLIC_LEGAL_EFFECTIVE_DATE=2026-07-29

# MySQL database
DATABASE_URL=mysql://senderwho:senderwho_password@localhost:3307/senderwho
DB_CONNECTION_LIMIT=5

# App auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=365
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# Production key ring format: key-id:base64-key,key-id-2:base64-key
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
# The backend requests openid, userinfo.email, and gmail.modify.
GMAIL_INITIAL_SYNC_MAX_MESSAGES=25
GMAIL_SYNC_BATCH_SIZE=20
GMAIL_SYNC_CONCURRENCY=4

# Data lifecycle (review with product/privacy counsel before production)
MESSAGE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
JOB_RETENTION_DAYS=90

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/microsoft/callback

# Yahoo OAuth 2.0 + IMAP (requires Yahoo approval for mail-r and mail-w)
# Keep false until Yahoo approves both scopes for the production application.
YAHOO_OAUTH_ENABLED=false
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/yahoo/callback
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
