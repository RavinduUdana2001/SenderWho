NODE_ENV=production
HOSTINGER_SHARED_HOSTING=true
API_PREFIX=api/v1
MOCK_DATA_ENABLED=false
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=256kb
SWAGGER_ENABLED=false

DATABASE_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@localhost:3306/DB_NAME

JWT_SECRET=replace_with_openssl_rand_hex_64
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=365
TOKEN_ENCRYPTION_KEYS=key-2026-07:replace_with_base64_32_byte_key
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=key-2026-07

GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret
GOOGLE_OAUTH_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/google/callback
# Keep false until Yahoo approves mail-r and mail-w for the application.
YAHOO_OAUTH_ENABLED=false
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_OAUTH_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/yahoo/callback
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
CORS_ORIGINS=https://api.example.com

GMAIL_INITIAL_SYNC_MAX_MESSAGES=500
GMAIL_SYNC_BATCH_SIZE=20
GMAIL_SYNC_CONCURRENCY=4
MESSAGE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
JOB_RETENTION_DAYS=90
