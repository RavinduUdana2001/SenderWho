# Copy this file to .env.hostinger on the VPS. Never commit or share the real file.
API_DOMAIN=api.example.com
SENDERWHO_IMAGE_TAG=2026-07-21-1

# Use URL-safe hex values so DATABASE_URL parsing is reliable.
MYSQL_PASSWORD=replace_with_openssl_rand_hex_32
MYSQL_ROOT_PASSWORD=replace_with_a_different_openssl_rand_hex_32
JWT_SECRET=replace_with_openssl_rand_hex_64

# Generate a key with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=key-2026-07:replace_with_base64_32_byte_key
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=key-2026-07

GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret
